{
  "name": "n00b-project",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "check:cycles": "madge --circular --extensions ts --ts-config tsconfig.json src",
    "format": "prettier --write .",
    "check": "npm run lint && npm run check:cycles && npm test && npm run build"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "madge": "^8.0.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
